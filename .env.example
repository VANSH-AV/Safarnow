# Copy to .env and fill from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Gemini API key for the AI travel assistant (server-side only, NOT exposed to the browser).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: override the Gemini model used by /api/ai/chat
# GEMINI_MODEL=gemini-3.6-flash