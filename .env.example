# Copy to .env and fill from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Clerk publishable key for Google OAuth + email/password sign-in.
# Get it at https://dashboard.clerk.com > your app > API Keys.
# Enable Google in Clerk Dashboard > User & Authentication > Social Connections.
# NOTE: On Vercel the app reads this at RUNTIME from /api/config, so also add
# VITE_CLERK_PUBLISHABLE_KEY as a Vercel env var (and VITE_SUPABASE_* for parity).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_KEY

# Gemini API key for the AI travel assistant (server-side only, NOT exposed to the browser).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: override the default Gemini model used by /api/ai/chat.
# Defaults to gemini-3.6-flash (the first model in the server-side pool).
GEMINI_MODEL=gemini-3.6-flash

# Optional: comma-separated fallback models tried in order when the primary is
# down (429/5xx) or returns empty content. Defaults to a built-in pool
# (gemini-3.8-flash → gemini-3.7-flash → gemini-3.5-flash → gemini-3.1-pro-preview).
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-pro-preview

# --- Server secrets required on Vercel for /api/data (user data proxy) ---
# These are NEVER sent to the browser. Configure them as Vercel env vars only:
#   CLERK_SECRET_KEY          - from Clerk Dashboard > API Keys (secret key)
#   SUPABASE_SERVICE_ROLE_KEY - Supabase Dashboard > Settings > API (service role)
#   SUPABASE_URL              - same value as VITE_SUPABASE_URL (used by the API)